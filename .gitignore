# Public repository allowlist. Local history/prototypes stay on disk.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/AGENTS.md
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/LICENSE-CONTENT.md
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md
!/TODO.md
!/package.json
!/package-lock.json
!/playwright.config.js
!/tests/
!/index.html
!/mark.svg
!/styles.css
!/app.js
!/content*.js
!/creator-interview.js
!/server.mjs
!/check.mjs
!/scripts/
!/skills/
!/docs/
!/assets/
/assets/*
!/assets/home-hero-art.png
!/assets/creator-profile-map.webp
!/assets/learning-loop.webp
!/assets/ILLUSTRATIONS.md
/docs/design-references/
**/.DS_Store
**/*.log
**/.env*
**/node_modules/
**/test-results/
**/playwright-report/
**/__pycache__/
**/*.pyc
/scripts/check-legacy.mjs
